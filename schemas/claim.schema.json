{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junction.example/schemas/claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": ["v", "type", "squadId", "memberId", "sessionId", "rank", "issuedAt"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "claim" },
    "squadId": { "type": "string", "pattern": "^sq_[a-z2-7]{16}$" },
    "memberId": { "type": "string", "pattern": "^m_[a-z2-7]{16}$" },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "rank": { "type": "integer", "minimum": 0 },
    "issuedAt": { "type": "string", "format": "date-time" }
  }
}
