{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junction.example/schemas/signal.schema.json",
  "title": "Signal (scout note)",
  "type": "object",
  "required": ["v", "type", "squadId", "memberId", "sessionId", "code", "verdict", "issuedAt"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "signal" },
    "squadId": { "type": "string", "pattern": "^sq_[a-z2-7]{16}$" },
    "memberId": { "type": "string", "pattern": "^m_[a-z2-7]{16}$" },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "code": { "type": "string", "pattern": "^[A-Z]{2,6}[0-9]{2,4}[A-Z]?(-[A-Z]+[0-9]*)?$" },
    "verdict": { "enum": ["worth-it", "skip-repeat", "crowded", "wrong-level", "moved"] },
    "note": { "type": "string", "maxLength": 140 },
    "issuedAt": { "type": "string", "format": "date-time" }
  }
}
