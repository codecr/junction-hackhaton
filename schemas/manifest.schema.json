{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junction.example/schemas/manifest.schema.json",
  "title": "Manifest (session IDs and codes only)",
  "type": "object",
  "required": ["v", "type", "squadId", "memberId", "seq", "issuedAt", "eventId", "catalogHash", "share", "sessions"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "manifest" },
    "squadId": { "type": "string", "pattern": "^sq_[a-z2-7]{16}$" },
    "memberId": { "type": "string", "pattern": "^m_[a-z2-7]{16}$" },
    "seq": { "type": "integer", "minimum": 0 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "catalogHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "share": { "enum": ["L0", "L1", "L2"] },
    "sessions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["sessionId", "code", "status"],
        "additionalProperties": false,
        "properties": {
          "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "code": { "type": "string", "pattern": "^[A-Z]{2,6}[0-9]{2,4}[A-Z]?(-[A-Z]+[0-9]*)?$" },
          "status": { "enum": ["reserved", "favorite", "maybe"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
          "locked": { "type": "boolean", "default": false },
          "role": { "enum": ["attendee", "speaker"], "default": "attendee" }
        }
      }
    },
    "busy": {
      "type": "array",
      "maxItems": 100,
      "description": "Only allowed when share is L1 or L2.",
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "additionalProperties": false,
        "properties": { "start": { "type": "string", "format": "date-time" }, "end": { "type": "string", "format": "date-time" } }
      }
    },
    "at": {
      "type": "object",
      "description": "Only allowed when share is L2.",
      "required": ["venue", "since"],
      "additionalProperties": false,
      "properties": { "venue": { "type": "string", "maxLength": 64 }, "since": { "type": "string", "format": "date-time" } }
    }
  },
  "allOf": [
    { "if": { "properties": { "share": { "const": "L0" } } }, "then": { "not": { "anyOf": [ { "required": ["busy"] }, { "required": ["at"] } ] } } },
    { "if": { "properties": { "share": { "const": "L1" } } }, "then": { "not": { "required": ["at"] } } }
  ]
}
