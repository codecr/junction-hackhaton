{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junction.example/schemas/charter.schema.json",
  "title": "Charter (squad rules, signed by the leader)",
  "type": "object",
  "required": ["v", "type", "squadId", "name", "eventId", "leader", "seq", "issuedAt", "expiresAt", "inviteVerifier", "members", "topics"],
  "additionalProperties": false,
  "properties": {
    "v": { "const": 1 },
    "type": { "const": "charter" },
    "squadId": { "type": "string", "pattern": "^sq_[a-z2-7]{16}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "leader": { "type": "string", "pattern": "^m_[a-z2-7]{16}$" },
    "seq": { "type": "integer", "minimum": 0 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "inviteVerifier": { "type": "string", "contentEncoding": "base64url" },
    "members": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["memberId", "name", "publicKey", "role", "joinedAt"],
        "additionalProperties": false,
        "properties": {
          "memberId": { "type": "string", "pattern": "^m_[a-z2-7]{16}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "publicKey": { "type": "string", "contentEncoding": "base64url" },
          "role": { "enum": ["leader", "member"] },
          "joinedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "topics": {
      "type": "array", "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "label", "weight", "target"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
          "label": { "type": "string", "maxLength": 60 },
          "weight": { "type": "integer", "minimum": 1, "maximum": 5 },
          "target": { "type": "integer", "minimum": 1, "maximum": 5 },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topics": { "type": "array", "items": { "type": "string" } },
              "services": { "type": "array", "items": { "type": "string" } },
              "tracks": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "mustCover": {
      "type": "array", "maxItems": 100,
      "items": { "type": "object", "required": ["sessionId"], "additionalProperties": false, "properties": { "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 } } }
    },
    "lunch": {
      "type": "object", "required": ["start", "end", "protected"], "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "protected": { "type": "boolean" }
      }
    },
    "caps": { "type": "object", "additionalProperties": false, "properties": { "maxPerDay": { "type": "integer", "minimum": 1, "maximum": 12 } } },
    "travel": { "type": "object", "additionalProperties": false, "properties": { "bufferMin": { "type": "integer", "minimum": 0, "maximum": 30 } } },
    "tolerance": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
