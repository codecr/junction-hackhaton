{
  "name": "junction",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Squad coordination for AWS re:Invent 2026",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "scripts": {
    "dev": "npm run build -w @junction/web && tsx packages/agent/src/cli.ts ui",
    "demo": "npm run dev -w @junction/web -- --mode demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "shots": "npm run shots -w @junction/web",
    "fixtures": "tsx fixtures/cli.ts",
    "guard": "node scripts/guard-catalog.mjs",
    "site": "node scripts/assemble-site.mjs",
    "infra:synth": "npm run synth -w @junction/infra",
    "infra:diff": "npm run diff -w @junction/infra",
    "infra:deploy": "npm run deploy -w @junction/infra",
    "prepare": "simple-git-hooks || exit 0",
    "build:web": "npm run build -w @junction/web && npm run build:demo -w @junction/web",
    "junction": "tsx packages/agent/src/cli.ts",
    "mcp": "tsx packages/mcp/src/index.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/guard-catalog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
